PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
SESSION_DB_PATH=./data/driftwatch.sqlite
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret

# Comma-separated browser origins allowed to call the API. Leave empty for the local default.
ALLOWED_ORIGINS=

# Optional: raises the GitHub API rate limit for history scans. Leave empty in this file.
GITHUB_TOKEN=

# Set to 1 when TLS is terminated by a trusted reverse proxy.
TRUST_PROXY=0

# Optional Dr. Drift provider: anthropic, openai, or gemini.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=